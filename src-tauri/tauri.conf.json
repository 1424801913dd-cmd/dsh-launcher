{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Launcher",
  "version": "0.4.1",
  "identifier": "com.dshlauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Launcher",
        "width": 1020,
        "height": 800,
        "minWidth": 760,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "resources": {
      "resources/dsh-bridge.mjs": "resources/dsh-bridge.mjs",
      "resources/runtime-update-config.json": "resources/runtime-update-config.json",
      "../LICENSE": "resources/DSH_LAUNCHER_LICENSE.txt",
      "../docs/PRIVACY.md": "resources/PRIVACY.md",
      "../docs/USER_GUIDE.md": "resources/USER_GUIDE.md",
      "../docs/CODE_SIGNING_POLICY.md": "resources/CODE_SIGNING_POLICY.md",
      "../docs/RELEASE_REVIEW.md": "resources/RELEASE_REVIEW.md",
      "../docs/THIRD_PARTY_NOTICES.md": "resources/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "DSH Launcher",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
